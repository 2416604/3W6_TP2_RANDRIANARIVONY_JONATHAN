@model IEnumerable<Recette>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Description</th>
            <th>Durée (min)</th>
            <th>Cuisson (min)</th>
            <th>Image</th>
            <th>Catégorie</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Nom)
                </td>
                <td style="width:250px;">
                    @Html.DisplayFor(model => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(model => item.TempsPreparation)
                </td>
                <td>
                    @Html.DisplayFor(model => item.TempsCuisson)
                </td>
                <td>
                    @if (item.Image != null)
                    {
                        <img src="~/images/@item.Image" style="width:150px" />
                    }
                </td>
                <td>
                    @item.Categorie.Nom
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
